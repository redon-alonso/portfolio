{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "blog": "node scripts/build-blog.mjs",
    "blog:watch": "node --watch-path=content/blog --watch-path=src/app/datos scripts/build-blog.mjs",
    "prestart": "npm run blog",
    "prebuild": "npm run blog",
    "preview": "npx --yes serve dist/portfolio/browser",
    "postbuild": "node -e \"require('fs').copyFileSync('dist/portfolio/browser/404/index.html','dist/portfolio/browser/404.html')\""
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.1",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^22.12.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.0",
    "marked-highlight": "^2.2.4",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}